{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Plain static site: every file in ./public is served as-is. No build step.
  "name": "bhagyankcalculator",
  "compatibility_date": "2026-11-01",
  // Only serve the site on www.bhagyank-calculator.online (custom domain). No *.workers.dev copy, no preview URLs,
  // so Google never sees a duplicate of the site on another address.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
